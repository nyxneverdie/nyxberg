# Neon pooled PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Public URL, used for origin checks. Production: https://nyxberg.vercel.app
APP_URL=http://localhost:3000
# Private S3-compatible bucket for Git objects
S3_ENDPOINT=https://your-s3-endpoint
S3_REGION=auto
S3_BUCKET=nyxberg-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Transactional email (required for registration and password reset)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=NyxBerg <noreply@example.com>
# Random unique value to make stored rate-limit hashes harder to correlate
RATE_LIMIT_SALT=replace-with-a-long-random-value
# Secret used by Vercel Cron for stale staging cleanup
CRON_SECRET=replace-with-a-long-random-value
